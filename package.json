{
  "name": "explore-browser",
  "private": true,
  "version": "1.6.697",
  "description": "Navigateur Explore - Le web réinventé",
  "author": "Foxy",
  "license": "GPL-3.0",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.explore.browser",
    "productName": "Explore Browser",
    "artifactName": "Explore-Browser-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "splash.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Explore Browser",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png",
      "category": "Network"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Julien0ff",
        "repo": "explore-app",
        "releaseType": "release"
      }
    ]
  },
  "scripts": {
    "dev:server": "vite",
    "type-check:electron": "tsc -p electron/tsconfig.json",
    "start:electron": "cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:3002 electron .",
    "dev:electron": "tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "dev": "node scripts/dev.js",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.2",
    "@cliqz/adblocker-electron": "^1.26.12",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/vite": "^4.2.0",
    "adm-zip": "^0.5.17",
    "clsx": "^2.1.1",
    "cross-fetch": "^4.0.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^9.39.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
